class Solution {
    public int strStr(String haystack, String needle) {
        // Edge case: if needle is empty, return 0 (by convention)
        if (needle.isEmpty()) {
            return 0;
        }

        int hLen = haystack.length();
        int nLen = needle.length();

        // Loop through haystack until there's enough room left for needle
        for (int i = 0; i <= hLen - nLen; i++) {
            // Check substring of haystack with length equal to needle
            if (haystack.substring(i, i + nLen).equals(needle)) {
                return i; // Found first occurrence
            }
        }

        return -1; // Not found
    }
}
