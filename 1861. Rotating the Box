class Solution {
    public char[][] rotateTheBox(char[][] box) {
        int m = box.length;
        int n = box[0].length;
        
        // Step 1: simulate gravity (stones fall to the right)
        for (int i = 0; i < m; i++) {
            int emptyPos = n - 1; // rightmost position where stone can fall
            
            for (int j = n - 1; j >= 0; j--) {
                if (box[i][j] == '*') {
                    emptyPos = j - 1; // reset after obstacle
                } 
                else if (box[i][j] == '#') {
                    // move stone to emptyPos
                    box[i][j] = '.';
                    box[i][emptyPos] = '#';
                    emptyPos--;
                }
            }
        }
        
        // Step 2: rotate matrix 90° clockwise
        char[][] res = new char[n][m];
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                res[j][m - 1 - i] = box[i][j];
            }
        }
        
        return res;
    }
}
