class Solution {
    public boolean check(int[] nums) {
        int count = 0;
        int n = nums.length;

        for (int i = 0; i < n; i++) {

            // compare current with next element
            if (nums[i] > nums[(i + 1) % n]) {
                count++;
            }

            // more than one break means not sorted & rotated
            if (count > 1) {
                return false;
            }
        }

        return true;
    }
}
