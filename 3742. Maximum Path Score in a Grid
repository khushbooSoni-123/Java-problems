    import java.util.*;

    class Solution {
        public int maxPathScore(int[][] grid, int k) {
            int m = grid.length, n = grid[0].length;
            
            // dp[i][j][c] = max score reaching (i,j) with cost c
            int[][][] dp = new int[m][n][k + 1];
            
            // initialize with -inf
            for (int i = 0; i < m; i++)
                for (int j = 0; j < n; j++)
                    Arrays.fill(dp[i][j], -1);
            
            dp[0][0][0] = 0; // start
            
            for (int i = 0; i < m; i++) {
                for (int j = 0; j < n; j++) {
                    for (int cost = 0; cost <= k; cost++) {
                        if (dp[i][j][cost] == -1) continue;
                        
                        // move RIGHT
                        if (j + 1 < n) {
                            int v = grid[i][j + 1];
                            int addCost = (v == 0 ? 0 : 1);
                            int newCost = cost + addCost;
                            
                            if (newCost <= k)
                                dp[i][j + 1][newCost] = Math.max(
                                    dp[i][j + 1][newCost],
                                    dp[i][j][cost] + v
                                );
                        }
                        
                        // move DOWN
                        if (i + 1 < m) {
                            int v = grid[i + 1][j];
                            int addCost = (v == 0 ? 0 : 1);
                            int newCost = cost + addCost;
                            
                            if (newCost <= k)
                                dp[i + 1][j][newCost] = Math.max(
                                    dp[i + 1][j][newCost],
                                    dp[i][j][cost] + v
                                );
                        }
                    }
                }
            }
            
            int ans = -1;
            for (int c = 0; c <= k; c++)
                ans = Math.max(ans, dp[m - 1][n - 1][c]);
            
            return ans;
        }
    }
