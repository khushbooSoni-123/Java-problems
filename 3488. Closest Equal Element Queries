import java.util.*;

class Solution {
    public List<Integer> solveQueries(int[] nums, int[] queries) {
        int n = nums.length;
        
        // value -> indices mapping
        Map<Integer, List<Integer>> map = new HashMap<>();
        for (int i = 0; i < n; i++) {
            map.computeIfAbsent(nums[i], k -> new ArrayList<>()).add(i);
        }
        
        List<Integer> ans = new ArrayList<>();
        
        for (int idx : queries) {
            int val = nums[idx];
            List<Integer> list = map.get(val);
            
            if (list.size() == 1) {
                ans.add(-1);
                continue;
            }
            
            int pos = Collections.binarySearch(list, idx);
            
            int prevIndex = list.get((pos - 1 + list.size()) % list.size());
            int nextIndex = list.get((pos + 1) % list.size());
            
            int distPrev = Math.min(Math.abs(idx - prevIndex), n - Math.abs(idx - prevIndex));
            int distNext = Math.min(Math.abs(idx - nextIndex), n - Math.abs(idx - nextIndex));
            
            ans.add(Math.min(distPrev, distNext));
        }
        
        return ans;
    }
}
