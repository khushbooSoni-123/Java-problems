import java.util.*;

class Solution {
    public boolean hasValidPath(int[][] grid) {
        int m = grid.length, n = grid[0].length;

        // directions: up, right, down, left
        int[][] dirs = {{-1,0},{0,1},{1,0},{0,-1}};
        
        // allowed directions for each street type
        int[][] street = {
            {},                 // dummy 0
            {1,3},              // type 1: left-right
            {0,2},              // type 2: up-down
            {2,3},              // type 3: left-down
            {1,2},              // type 4: right-down
            {0,3},              // type 5: left-up
            {0,1}               // type 6: right-up
        };

        boolean[][] visited = new boolean[m][n];
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[]{0,0});
        visited[0][0] = true;

        while(!q.isEmpty()){
            int[] cur = q.poll();
            int r = cur[0], c = cur[1];

            if(r == m-1 && c == n-1) return true;

            int type = grid[r][c];

            for(int d : street[type]) {
                int nr = r + dirs[d][0];
                int nc = c + dirs[d][1];

                if(nr<0 || nc<0 || nr>=m || nc>=n || visited[nr][nc]) 
                    continue;

                int nextType = grid[nr][nc];

                // reverse direction check
                int rev = (d + 2) % 4;
                for(int nd : street[nextType]) {
                    if(nd == rev) {
                        visited[nr][nc] = true;
                        q.offer(new int[]{nr,nc});
                        break;
                    }
                }
            }
        }
        return false;
    }
}
