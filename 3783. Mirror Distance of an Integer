class Solution {
    public int mirrorDistance(int n) {
        int original = n;
        int rev = 0;
        
        // Step 1: Reverse the number
        while (n > 0) {
            int digit = n % 10;
            rev = rev * 10 + digit;
            n /= 10;
        }
        
        // Step 2: Return absolute difference
        return Math.abs(original - rev);
    }
}
