import java.util.*;

public class Solution {
    public long[] distance(int[] nums) {
        int n = nums.length;
        long[] ans = new long[n];
        
        // Step 1: group indices by value
        Map<Integer, List<Integer>> map = new HashMap<>();
        for(int i = 0; i < n; i++){
            map.computeIfAbsent(nums[i], k -> new ArrayList<>()).add(i);
        }
        
        // Step 2: process each group
        for(List<Integer> list : map.values()){
            int m = list.size();
            long totalSum = 0;
            
            // total sum of indices
            for(int idx : list) totalSum += idx;
            
            long prefixSum = 0;
            
            for(int i = 0; i < m; i++){
                int idx = list.get(i);
                
                // left contribution
                long left = (long)i * idx - prefixSum;
                
                // right contribution
                long right = (totalSum - prefixSum - idx) - (long)(m - i - 1) * idx;
                
                ans[idx] = left + right;
                
                prefixSum += idx;
            }
        }
        
        return ans;
    }
}
